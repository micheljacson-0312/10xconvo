{
  "_README": "Copy this file as appsettings.Production.json and fill in ALL values. DO NOT commit this file to Git.",

  "ConnectionStrings": {
    "Default": "Server=YOUR_SERVER;Database=TenXConvo;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;",
    "QA":      "Server=YOUR_SERVER;Database=TenXConvo_QA;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;",
    "Production": "Server=YOUR_SERVER;Database=TenXConvo_PROD;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;"
  },

  "Jwt": {
    "Key":               "GENERATE_WITH: openssl rand -base64 48 → paste the 64-char result here",
    "Issuer":            "https://api.yourdomain.com",
    "Audience":          "yourdomain"
  },

  "Cors": {
    "AdminOrigins":      ["https://admin.yourdomain.com"],
    "ConsultantOrigins": ["https://consultant.yourdomain.com"],
    "UserOrigins":       ["https://user.yourdomain.com"]
  },

  "PortalUrls": {
    "Admin":      "https://admin.yourdomain.com",
    "Consultant": "https://consultant.yourdomain.com",
    "User":       "https://user.yourdomain.com"
  },

  "FileStorage": {
    "BaseUrl": "https://api.yourdomain.com/uploads"
  },

  "Twilio": {
    "AccountSid":   "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "AuthToken":    "your_real_twilio_auth_token",
    "FromNumber":   "+1234567890",
    "WhatsAppFrom": "whatsapp:+14155238886"
  },

  "SendGrid": {
    "ApiKey":    "SG.real_sendgrid_api_key_here",
    "FromEmail": "noreply@yourdomain.com",
    "FromName":  "10X Convo"
  },

  "Redis": {
    "Enabled":          true,
    "ConnectionString": "your-redis-host:6379,password=your-redis-password",
    "InstanceName":     "TenXConvo_Prod_"
  },

  "WebPush": {
    "VapidPublicKey":  "GENERATE_WITH: npx web-push generate-vapid-keys → paste public key",
    "VapidPrivateKey": "GENERATE_WITH: npx web-push generate-vapid-keys → paste private key",
    "VapidSubject":    "mailto:admin@yourdomain.com"
  },

  "OAuth": {
    "Google": {
      "ClientId":     "FROM: https://console.cloud.google.com/apis/credentials",
      "ClientSecret": "FROM: same page → OAuth 2.0 Client → Client Secret"
    },
    "Microsoft": {
      "ClientId":     "FROM: https://portal.azure.com → App Registrations",
      "ClientSecret": "FROM: same page → Certificates & secrets"
    }
  }
}
