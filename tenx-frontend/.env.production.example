# ═══════════════════════════════════════════════════════════════════════════
#  TenXConvo Frontend — Production Environment Variables
#  
#  HOW TO USE:
#  1. Copy this file into EACH portal folder as .env.production:
#       cp .env.production.example admin-portal/.env.production
#       cp .env.production.example consultant-portal/.env.production
#       cp .env.production.example user-portal/.env.production
#
#  2. Edit each copy if portals need different values (usually same API URL)
#
#  3. Build each portal:
#       cd admin-portal && npm run build
#       cd consultant-portal && npm run build  
#       cd user-portal && npm run build
#
#  4. Deploy the dist/ folder from each portal to your web server
#
#  NOTE: These values are BAKED INTO the build output (dist/).
#        After changing any value, you MUST rebuild (npm run build).
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────────────
# Your backend API URL (no trailing slash)
VITE_API_URL=https://api.yourdomain.com

# ── FIREBASE (required for user-portal social login) ─────────────────────
# Get these from: https://console.firebase.google.com → Project Settings
VITE_FIREBASE_API_KEY=AIzaSyAfTiyT-D_ZaJFQ9U9zTrc2ForpT6bSiCw
VITE_FIREBASE_AUTH_DOMAIN=x-convo-b09bc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=x-convo-b09bc
